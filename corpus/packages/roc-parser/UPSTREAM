# Provenance of the bundled lukewilliamboswell/roc-parser package. Paths are
# relative to this directory.

repo     https://github.com/lukewilliamboswell/roc-parser
tag      3.0.0
commit   c542066
tarball  6xsRdRqenJrAb4wG7HaST4Xh349vD5sHAJDsKTK6E3dr.tar.zst
# The nightly the gates run the topics with: the one of basic-cli 0.26.0, which
# they pin. The release notes say 3.0.0 was built with nightly-2026-10-21-5349569
# and requires that or later; every program here also checks on the nightly below.
compiler nightly-2026-10-12-2664a27
depends  roc-lang/unicode 4.3.0 (7HGaK8HUHMs5judroSmUoS4TjPGZ1kAjPTyPDSCWiSKM), used by Markdown

index.json <- the tarball root, parsed by `npm run build:index` from the
              compiler's package cache. No source is vendored
examples/  <- the release's examples archive, roc-parser-examples-3.0.0.zip,
              unchanged except that the zip's spec.json and README.md are not
              bundled. It already pins basic-cli 0.25.0, so it needs no patch.
              assets/ holds the files that compile-time-parsing.roc imports
topics/    <- ours: one per module family, compiled by check:platforms. Each
              ends with links to the manual pages at tag 3.0.0. The manual
              itself is not bundled
verify/    <- ours: every snippet on overview.md, in one app
overview.md <- ours: the page get_roc_syntax(topic: "roc-parser") returns
